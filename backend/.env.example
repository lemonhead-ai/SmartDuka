SMARTDUKA_APP_NAME=Smart Duka API
SMARTDUKA_APP_VERSION=0.1.0
SMARTDUKA_ENVIRONMENT=development
SMARTDUKA_DEBUG=false
SMARTDUKA_LOG_LEVEL=INFO
SMARTDUKA_API_V1_PREFIX=/api/v1
# Local development uses SQLite. Production must use a durable Supabase Postgres
# Session Pooler connection string stored only in the Render environment group.
SMARTDUKA_DATABASE_URL=sqlite+aiosqlite:///./smartduka.db
# SMARTDUKA_DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres
# Cloud default: Groq serves Meta Llama and automatically falls back to
# OpenRouter when both API keys are configured. Select `openrouter` to reverse
# that order, or `ollama` only for local development.
SMARTDUKA_LLM_PROVIDER=groq
# Ollama Local (Free, offline, on-device Meta Llama 3.2 - runs via `ollama run llama3.2`)
SMARTDUKA_OLLAMA_BASE_URL=http://localhost:11434/v1
SMARTDUKA_OLLAMA_MODEL=llama3.2
# Each AI request has a short deadline; the game continues with a local
# inventory-aware customer if no provider responds in time.
SMARTDUKA_LLM_TIMEOUT_SECONDS=8
# Per-provider limit. Keep this lower than the total timeout so the backup
# cloud provider has time to answer.
SMARTDUKA_LLM_ATTEMPT_TIMEOUT_SECONDS=3.5
# Groq Free Cloud (Fast free tier for Meta Llama 3.3 / 3.1 - https://console.groq.com/keys)
SMARTDUKA_GROQ_API_KEY=
SMARTDUKA_GROQ_MODEL=llama-3.3-70b-versatile
SMARTDUKA_GROQ_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter Free Cloud (Meta Llama 3.3 70B - https://openrouter.ai/keys)
SMARTDUKA_OPENROUTER_API_KEY=
SMARTDUKA_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
SMARTDUKA_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Featherless (Llama 3.1)
SMARTDUKA_FEATHERLESS_API_KEY=
SMARTDUKA_FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
SMARTDUKA_FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
SMARTDUKA_FEATHERLESS_ENABLE_THINKING=false
# Gemini (Google AI Studio) Fallback or Primary Provider
SMARTDUKA_GEMINI_API_KEY=
SMARTDUKA_GEMINI_MODEL=gemini-2.5-flash
SMARTDUKA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SMARTDUKA_OPENAI_API_KEY=
SMARTDUKA_OPENAI_MODEL=gpt-5.6-low-effort
SMARTDUKA_ALLOWED_ORIGINS=["http://localhost:3000"]
SMARTDUKA_AUTH_SESSION_COOKIE_NAME=smartduka_session
SMARTDUKA_AUTH_SESSION_DAYS=14
# Set to true for HTTPS deployments such as Railway/Vercel.
SMARTDUKA_AUTH_COOKIE_SECURE=false
SMARTDUKA_PASSWORD_RESET_MINUTES=30
